{
  "hosting": {
    "public": "web/dist/web/browser",
    "predeploy": [
      "npm --prefix web ci",
      "npm --prefix web run build"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "server",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      "data",
      "test",
      ".git",
      "*.log"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
